# Conexión a MySQL
DATABASE_URL=mysql+pymysql://root:contraseña@127.0.0.1:3306/van

# Clave secreta para sesiones Flask (OBLIGATORIA — app no arranca sin esto)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ejemplo_de_clave_segura_de_64_chars_hex

# Opcional: modo debug (1 para activar)
# FLASK_DEBUG=0

# Opcional: SMTP para verificación de correo
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contraseña_app

# Opcional: clave de Google Maps (ya no se usa — mapas con Leaflet + OSM)
# MAPBOX_TOKEN=

# ─── Mercado Pago (para pago de empresas) ───
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu_token_aqui
# MERCADOPAGO_PUBLIC_KEY=APP_USR-tu_public_key_aqui
# ADMIN_SECRET_KEY=ejemplo_de_clave_segura_de_64_chars_hex

# ─── Cifrado de datos de pago ───
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# ─── Transferencia Bancaria (datos para pago de empresas) ───
# BANK_NAME=Banco Nación
# BANK_ACCOUNT_TYPE=Caja de Ahorro
# BANK_ACCOUNT_NUMBER=000123456789
# BANK_ACCOUNT_HOLDER=VAN SRL
# BANK_CUIT=30-12345678-9
# BANK_ALIAS=VAN.MP.123

# URL base (para webhooks de Mercado Pago)
# En desarrollo: http://127.0.0.1:5000
# En producción: https://tuapp.railway.app
# BASE_URL=http://127.0.0.1:5000
