# Base de datos. PostgreSQL es el objetivo (Alembic gestiona el esquema).
# En producción/local: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/van
DATABASE_URL=postgresql+psycopg://van:van@127.0.0.1:5432/van

# Moneda default de los viajes (ISO 4217). Es snapshot por viaje; cambiar
# esta variable no modifica viajes existentes.
# DEFAULT_CURRENCY=ARS

# Comisión de VAN por viaje como decimal (0.15 = 15%). Si no se define,
# la comisión queda desactivada (platform_fee=0, rate=NULL).
# Se almacena como snapshot en cada viaje (platform_fee_rate).
# PLATFORM_FEE_RATE=0.15

# Clave secreta para sesiones Flask (OBLIGATORIA — app no arranca sin esto)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ejemplo_de_clave_segura_de_64_chars_hex

# JWT para la API móvil (/api/v1). Si no se define, usa SECRET_KEY.
# En producción usar una clave dedicada.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY=
# JWT_ACCESS_TTL_MINUTES=30
# JWT_REFRESH_TTL_DAYS=30

# Opcional: modo debug (1 para activar)
# FLASK_DEBUG=0

# Opcional: nivel de log (DEBUG, INFO, WARNING, ERROR — default INFO)
# LOG_LEVEL=INFO

# Opcional: Sentry DSN para error tracking en producción
# Si se define, se inicializa automáticamente.
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0

# Opcional: SMTP para verificación de correo
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contraseña_app

# Opcional: clave de Google Maps (ya no se usa — mapas con Leaflet + OSM)
# MAPBOX_TOKEN=

# ─── Mercado Pago ───
# Entorno de credenciales: test | production (default production)
# MP_ENV=test → usa MERCADOPAGO_TEST_ACCESS_TOKEN (pagos con usuarios/tarjetas
# de prueba). MP_ENV=production → usa MERCADOPAGO_ACCESS_TOKEN.
# MP_ENV=test
#
# Credenciales de PRUEBA (devpanel → "Pruebas" → credenciales de prueba)
# MERCADOPAGO_TEST_ACCESS_TOKEN=APP_USR-token_de_prueba_aqui
# MERCADOPAGO_TEST_PUBLIC_KEY=APP_USR-public_key_de_prueba_aqui
#
# Credenciales de PRODUCCIÓN (activar en devpanel → "Producción")
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-token_de_produccion_aqui
# MERCADOPAGO_PUBLIC_KEY=APP_USR-public_key_de_produccion_aqui
#
# Secret de firma de webhooks (panel → Tus integraciones → Webhooks → clave).
# Si está configurado, las notificaciones se validan fail-closed con el
# manifest oficial ts/v1; sin él, solo verificación server-side del pago.
# Debe ser el MISMO valor configurado como URL del webhook en el panel.
# MP_WEBHOOK_SECRET=
#
ADMIN_SECRET_KEY=ejemplo_de_clave_segura_de_64_chars_hex

# ─── Cifrado de datos de pago ───
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# ─── Transferencia Bancaria (datos para pago de empresas) ───
# BANK_NAME=Banco Nación
# BANK_ACCOUNT_TYPE=Caja de Ahorro
# BANK_ACCOUNT_NUMBER=000123456789
# BANK_ACCOUNT_HOLDER=VAN SRL
# BANK_CUIT=30-12345678-9
# BANK_ALIAS=VAN.MP.123

# URL base (para back_urls y webhooks de Mercado Pago)
# En desarrollo: http://127.0.0.1:5000 (MP NO puede llamar webhooks locales).
# Dev con webhook real: túnel público (cloudflared tunnel --url localhost:5000)
#   → BASE_URL=https://xxx.trycloudflare.com → configurar esa misma URL en el
#   panel MP como webhook (eventos "Pagos") → copiar MP_WEBHOOK_SECRET acá.
# En producción: https://van.com.ar  ← OBLIGATORIO para auto_return+webhook.
# BASE_URL=http://127.0.0.1:5000

# Deep link scheme de la app Flutter (Fase 2). Si el cliente manda el header
# X-Client-Type: mobile, las back_urls usan este scheme (van://...) en vez de
# BASE_URL — MP redirige al WebView nativo y la app lo captura como link.
# APP_SCHEME=van://
